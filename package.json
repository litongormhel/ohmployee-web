{
  "name": "ohmployee_web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "node scripts/adr-mirror.mjs check && next dev",
    "dev:prod": "node scripts/switch-env.js prod && next dev",
    "build": "node scripts/adr-mirror.mjs check && next build",
    "build:staging": "node scripts/switch-env.js staging && next build",
    "build:prod": "node scripts/switch-env.js prod && next build",
    "start": "next start",
    "lint": "node scripts/adr-mirror.mjs check && node scripts/check-sql-contracts.mjs && eslint",
    "test": "node scripts/adr-mirror.mjs check && node scripts/check-sql-contracts.mjs && node --test src/lib/utils/__tests__/*.test.mjs src/lib/queries/__tests__/*.test.mjs",
    "check:sql": "node scripts/check-sql-contracts.mjs",
    "sync:migrations": "node scripts/sync-migrations.mjs",
    "db:push:staging": "node scripts/push-staging-migrations.mjs",
    "db:new": "node scripts/new-migration.mjs",
    "finish": "node scripts/finish.js",
    "check:adr": "node scripts/adr-mirror.mjs check",
    "sync:adr": "node scripts/adr-mirror.mjs sync"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.109",
    "@ai-sdk/react": "^4.0.163",
    "@supabase/supabase-js": "^2.106.1",
    "@tanstack/react-query": "^5.100.13",
    "ai": "^7.0.159",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
